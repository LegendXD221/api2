PORT=3000
NODE_ENV=production
API_KEY=change-me-to-a-long-secret
API_REQUIRE_AUTH=false
API_RATE_LIMIT=100
API_KEY_RATE_LIMIT=500

PUPPETEER_ENABLED=false

TWOCAPTCHA_API_KEY=
ANTICAPTCHA_API_KEY=
CAPSOLVER_API_KEY=

REDIS_URL=

STEALTH_USER_AGENT_ROTATION=true
STEALTH_HEADER_ORDER_RANDOMIZATION=true

TURNSTILE_PROXY_1_URL=
TURNSTILE_PROXY_1_KEY=

STRICT_ANTIBOT=false
CONCURRENCY=15
REQUEST_TIMEOUT=15000
LOG_LEVEL=info

# Optional upstream resolvers (comma-separated templates with {url})
BYPASS_UPSTREAM_URLS=

