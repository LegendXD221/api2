# ── API ───────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
API_KEY=your-secret-api-key-here
API_REQUIRE_AUTH=true
# Required in production when auth is enabled; use a long random secret.
API_RATE_LIMIT=100
API_KEY_RATE_LIMIT=500

# ── Puppeteer (disabled on Vercel free) ───────────────────────────────────────
PUPPETEER_ENABLED=false

# ── CAPTCHA Solvers (optional — fallback chain will still work without these) ─
TWOCAPTCHA_API_KEY=
ANTICAPTCHA_API_KEY=
CAPSOLVER_API_KEY=

# ── Turnstile proxy (optional) ────────────────────────────────────────────────
TURNSTILE_PROXY_1_URL=
TURNSTILE_PROXY_1_KEY=

# ── Redis (optional — uses in-memory cache if not set) ────────────────────────
REDIS_URL=

# ── Stealth ───────────────────────────────────────────────────────────────────
STEALTH_USER_AGENT_ROTATION=true
STEALTH_HEADER_ORDER_RANDOMIZATION=true
